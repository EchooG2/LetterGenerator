<Window x:Class="LetterGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Генератор писем" Height="750" Width="850">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Получатель -->
            <GroupBox Header="Получатель" Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Margin="10">
                    <Label Content="Кому (организация):" Margin="0,5,0,0"/>
                    <TextBox x:Name="KomyTextBox" Margin="0,0,0,10"/>

                    <Label Content="Адресат (должность и ФИО):" Margin="0,5,0,0"/>
                    <TextBox x:Name="AddresseeTextBox" Margin="0,0,0,10"/>

                    <Label Content="Имя адресата (в дательном падеже):" Margin="0,5,0,0"/>
                    <TextBox x:Name="AddresseeNameTextBox" Margin="0,0,0,5"/>
                </StackPanel>
            </GroupBox>

            <!-- 2. Содержание письма -->
            <GroupBox Header="Содержание письма" Grid.Row="1" Margin="0,0,0,10">
                <StackPanel Margin="10">
                    <Label Content="Тема письма:" Margin="0,5,0,0"/>
                    <TextBox x:Name="SubjectTextBox" Margin="0,0,0,10"/>

                    <Label Content="Текст письма:" Margin="0,5,0,0"/>
                    <TextBox x:Name="BodyTextBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" 
                             TextWrapping="Wrap" Height="120" Margin="0,0,0,5"/>
                </StackPanel>
            </GroupBox>

            <!-- 3. Отправитель -->
            <GroupBox Header="Отправитель" Grid.Row="2" Margin="0,0,0,10">
                <StackPanel Margin="10">
                    <Label Content="Подпись (должность и ФИО):" Margin="0,5,0,0"/>
                    <TextBox x:Name="ManagerTextBox" Margin="0,0,0,5"/>
                </StackPanel>
            </GroupBox>

            <!-- 4. Приложения -->
            <GroupBox Header="Приложения (вложения)" Grid.Row="3" Margin="0,0,0,10">
                <StackPanel Margin="10">
                    <DataGrid x:Name="AttachmentsGrid" AutoGenerateColumns="False" Height="150" Margin="0,0,0,5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Заголовок" Width="*" Binding="{Binding Title}"/>
                            <DataGridTextColumn Header="Содержание" Width="3*" Binding="{Binding Content}"/>
                            <DataGridTemplateColumn Header="Удалить" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="X" Click="RemoveAttachment_Click" Tag="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Content="Добавить приложение" Click="AddAttachment_Click" Width="150" HorizontalAlignment="Left"/>
                </StackPanel>
            </GroupBox>

            <!-- 5. Кнопка генерации -->
            <Button Grid.Row="4" Content="Сгенерировать письмо" Click="Generate_Click" 
                    Background="LightGreen" Height="40" Margin="0,10,0,0" FontSize="14" FontWeight="Bold"/>
        </Grid>
    </ScrollViewer>
</Window>